rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users may only access their own user document.
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Public survey reads; writes require a trusted admin custom claim.
    match /surveys/{surveyId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // A response must belong to the authenticated user. Validate incoming
    // ownership on create/update; resource.data is unavailable on create.
    match /responses/{responseId} {
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
      allow read, delete: if request.auth != null
        && resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
    }
  }
}
